{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/manifests/.*\\.yaml"
      ],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "\\s+version: (?:|\")(?<currentValue>.*?)(?:|\")",
        "\\s+repo: (?<registryUrl>.*?)",
        "\\s+chart: (?<packageName>.*?)"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}
