{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Make minor versions breaking changes",
      "matchPackageNames": [
        "argocd",
        "cilium"
      ],
      "allowedVersions": "<={{ add minor 1 }}"
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "**/manifests/*.yaml"
      ],
      "matchStrings": [
        "spec.{ \"depName\": chart, \"currentValue\": version, \"registryUrl\": repo}"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}
