{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "**/manifests/*.yaml"
      ],
      "matchStrings": [
        "spec.{ \"depName\": chart, \"currentValue\": version, \"registryUrl\": repo}"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}
